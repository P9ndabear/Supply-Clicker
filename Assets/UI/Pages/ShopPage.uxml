<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="Top" style="flex-grow: 1; height: 25%; align-items: flex-start; flex-direction: row; justify-content: space-between;">
            <ui:Button text="Exit Shop" name="ExitShopButton" style="width: 200px; height: 100px; font-size: 30px;"/>
            <ui:VisualElement name="BalanceContainer" style="flex-grow: 0; width: 200px; height: 100px; flex-shrink: 0; -unity-text-align: middle-center; justify-content: center; align-items: center; flex-direction: row;">
                <ui:Label text="" name="Balance"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" style="flex-grow: 1; height: 75%;"/>
    </ui:VisualElement>
</ui:UXML>
