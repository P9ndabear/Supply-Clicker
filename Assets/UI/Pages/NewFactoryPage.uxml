<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1;">
        <ui:VisualElement name="Top" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(255, 255, 255);">
            <ui:Button text="Back to Factory List" name="BackButton" style="width: 200px; height: 100px; font-size: 20px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Center" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(255, 255, 255);">
            <ui:TextField label="Text Field" placeholder-text="filler text" name="FactoryName"/>
        </ui:VisualElement>
        <ui:VisualElement name="Bottom" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(255, 255, 255); align-items: flex-end; justify-content: flex-end;">
            <ui:Button text="Create" name="CreateButton" style="width: 200px; height: 100px; font-size: 20px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
