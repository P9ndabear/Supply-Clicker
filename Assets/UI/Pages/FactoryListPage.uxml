<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="Top" style="flex-grow: 1; height: 25%;">
            <ui:Button text="Main Menu" name="MainMenuButton" style="width: 200px; height: 100px; font-size: 25px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Content" style="flex-grow: 1; height: 50%; justify-content: center; align-items: stretch; flex-direction: row;"/>
        <ui:VisualElement name="Bottom" style="flex-grow: 0; flex-shrink: 0; height: 25%;"/>
    </ui:VisualElement>
</ui:UXML>
